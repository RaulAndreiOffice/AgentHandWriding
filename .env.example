# OpenAI-compatible VLM endpoint
# Ollama:  http://localhost:11434/v1
# vLLM:    http://localhost:8001/v1
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=not-needed
VLM_MODEL=qwen2.5vl:7b
VLM_MAX_TOKENS=4096
VLM_TEMPERATURE=0.0
VLM_TIMEOUT=300
VLM_MAX_MODEL_LEN=1024
# Dedicated sign-table prompt for regions tagged "table" (off: the 2B model loops on it)
VLM_TABLE_PROMPT=false

# Line segmentation pipeline
VLM_CONCURRENCY=2
SEG_MAX_LINES=80
# Unset = automatic (derived from the page's glyph height). Pixels at the 2000 px working scale.
# SEG_BOX_MERGE_GAP_PX=15   # merge stacked boxes closer than this (split matrix rows, fractions)
# SEG_ROW_MERGE_THRESHOLD_PX=8
SEG_GRID_FILTER_STRENGTH=0.5
SEG_MARGIN_EXCLUDE_FRAC=0.08
# Columns (figure beside calculations) and region kinds (table / diagram)
SEG_SPLIT_COLUMNS=true
# SEG_COLUMN_GAP_PX=60
SEG_CLASSIFY_REGIONS=true
# Leave out lines the student crossed out (saves a VLM call each)
SEG_DROP_STRUCK_OUT=true

# Phase 2 verifier (corrections + green/yellow/grey status per line)
VERIFY_TRANSCRIPTIONS=true

# Targeted re-ask of yellow/grey lines (extra VLM calls only for those lines).
REASK_ENABLED=false
REASK_MAX_QUESTIONS_PER_LINE=3

MAX_UPLOAD_MB=10
